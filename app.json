{
  "expo": {
    "name": "NEPAL Motor",
    "slug": "nepal-motor",
    "version": "1.0.56",
    "orientation": "portrait",
    "icon": "./assets/nm-logo-icon.png",
    "splash": {
      "image": "./assets/nm-logo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pracas.nepalmotor",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow NEPAL Motor to access your photos so you can upload vehicle images."
      }
    },
    "android": {
      "package": "com.pracas.nepalmotor",
      "versionCode": 46,
      "adaptiveIcon": {
        "foregroundImage": "./assets/nm-logo-adaptive-fg.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/nm-logo-icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "photosPermission": "Allow NEPAL Motor to access your photos so you can upload vehicle images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "28600e8e-977f-42b2-8141-8abe2cde0e63"
      }
    },
    "owner": "mr.ded"
  }
}
