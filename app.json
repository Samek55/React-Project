{
  "expo": {
    "name": "NEPAL Motor",
    "slug": "nepal-motor",
    "version": "1.0.57",
    "orientation": "portrait",
    "icon": "./assets/nm-logo-icon.png",
    "splash": {
      "image": "./assets/nm-logo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pracas.nepalmotor",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow NEPAL Motor to access your photos so you can upload vehicle images."
      }
    },
    "android": {
      "package": "com.pracas.nepalmotor",
      "googleServicesFile": "./google-services.json",
      "notification": {
        "icon": "./assets/nm-notification-icon.png",
        "color": "#1a6b5a"
      },
      "versionCode": 47,
      "adaptiveIcon": {
        "foregroundImage": "./assets/nm-logo-adaptive-fg.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/nm-logo-icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "photosPermission": "Allow NEPAL Motor to access your photos so you can upload vehicle images."
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIcons": ["./assets/nm-notification-icon.png"],
          "largeIcons": ["./assets/nm-logo-large-icon.png"],
          "smallIconAccentColor": "#1a6b5a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "28600e8e-977f-42b2-8141-8abe2cde0e63"
      },
      "oneSignalAppId": "37dbdf6b-f85b-43f8-9d13-8a320031def9"
    },
    "owner": "mr.ded"
  }
}
