{
  "expo": {
    "name": "NEPAL Motor",
    "slug": "nepal-motor-exchange-form",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/nepal-flag-logo.jpeg",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.samek55.nepalmotorexchange",
      "adaptiveIcon": {
        "foregroundImage": "./assets/nepal-flag-logo.jpeg",
        "backgroundColor": "#f7fafc"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/nepal-flag-logo.jpeg"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
